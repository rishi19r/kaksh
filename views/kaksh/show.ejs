<%- layout('layouts/boilerplate') %>
<link rel="stylesheet" href="/stylesheet/star.css" />
<link rel="stylesheet" href="/stylesheet/style2.css" />
<link rel="stylesheet" href="/stylesheet/style.css" />

<div class="page-container my-4">

  <div class="flex-row">

    <!-- Room Details Section -->
    <div class="flex-col half-width">
      <div class="custom-card">

        <div id="roomCarousel" class="carousel slide" data-bs-ride="carousel">
          <div class="carousel-inner">
            <% rooms.images.forEach((img, index) => { %>
              <div class="carousel-item <%= index === 0 ? 'active' : '' %>">
                <img src="<%= img.url %>" alt="Room Image" class="carousel-img" />
              </div>
            <% }); %>
          </div>
          <button class="carousel-control-prev" type="button" data-bs-target="#roomCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
          </button>
          <button class="carousel-control-next" type="button" data-bs-target="#roomCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
          </button>
        </div>

        <div class="custom-card-body">
          <h5 class="title">Address: <%= rooms.address %></h5>
          <h6 class="subtitle">Owner: <%= rooms.owner %></h6>
          <p>Area: <%= rooms.area %></p>
          <p>Rules: <%= rooms.rules %></p>
          <p>Rent: ₹<%= rooms.rent %></p>
          <p>Room Size: <%= rooms.roomSize %></p>
          <p>People Allowed: <%= rooms.peopleCanStay %></p>
          <p class="small-text">Contact: <%= rooms.contact %></p>
          <p class="small-text">Suggested by: <%= rooms.author.username %></p>

          <% if(currentUser && rooms.author.equals(currentUser._id)){ %>
          <div class="button-group">
            <form action="/kaksh/<%= rooms._id %>?_method=delete" method="post">
              <button class="btn-danger">Delete</button>
            </form>
            <a href="/kaksh" class="btn-primary">Go Back</a>
            <a href="/kaksh/<%= rooms._id %>/edit" class="btn-secondary">Edit</a>
            <a href="/kaksh/new" class="btn-success">Add New Room</a>
          </div>
          <% } %>
        </div>

      </div>
    </div>

    <!-- Review Section -->
    <div class="flex-col half-width">
      <% if(currentUser){ %>
      <div class="custom-card">
        <div class="card-header-primary">
          <h5>Leave a Review</h5>
        </div>
        <div class="custom-card-body">
          <form action="/kaksh/<%= rooms._id %>/review" method="POST">
            <div class="mb-3">
              <fieldset class="starability-basic">
                <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="0" checked aria-label="No rating." />
                <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                <label for="first-rate1" title="Terrible">1 star</label>
                <input type="radio" id="first-rate2" name="review[rating]"  value="2" />
                <label for="first-rate2" title="Not good">2 stars</label>
                <input type="radio" id="first-rate3" name="review[rating]"  value="3" />
                <label for="first-rate3" title="Average">3 stars</label>
                <input type="radio" id="first-rate4" name="review[rating]"  value="4" />
                <label for="first-rate4" title="Very good">4 stars</label>
                <input type="radio" id="first-rate5" name="review[rating]"  value="5" />
                <label for="first-rate5" title="Amazing">5 stars</label>
              </fieldset>
            </div>
            <div class="mb-3">
              <label for="comment" class="form-label">Comment</label>
              <textarea name="review[comment]" id="comment" rows="4" placeholder="Write your feedback..." class="textarea"></textarea>
            </div>
            <button class="btn-outline-primary" type="submit">Submit Review</button>
          </form>
        </div>
      </div>
      <% } %>

      <% if (rooms.reviews.length > 0) { %>
        <div class="reviews-list">
          <h5>Reviews:</h5>
          <% for(let review of rooms.reviews){ %>
            <div class="custom-card review-card">
              <div class="custom-card-body">
                <p class="small-text">Username: <%= review.author.username %></p>
                <p class="starability-result" data-rating="<%= review.rating %>"></p>
                <p><b>Comment:</b> <%= review.comment %></p>
                <% if(currentUser && review.author.equals(currentUser._id)){ %>
                <form action="/kaksh/<%= rooms._id %>/review/<%= review._id %>?_method=delete" method="post">
                  <button class="btn-sm btn-danger">Delete</button>
                </form>
                <% } %>
              </div>
            </div>
          <% } %>
        </div>
      <% } else { %>
        <div class="alert-info">No reviews yet. Be the first to review!</div>
      <% } %>
    </div>
  </div>
</div>
