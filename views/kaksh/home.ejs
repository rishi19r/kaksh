<%- layout('layouts/boilerplate') %>
  <title>Kaksh | Home</title>
  <link rel="stylesheet" href="/css/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap" rel="stylesheet">
  <style>
    body {
      margin: 0;
      font-family: 'Poppins', sans-serif;
      background-color: #f7f7f7;
    }

    .hero {
      background-size: cover;
      background-position: center;
      height: 90vh;
      color: white;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-direction: column;
      text-align: center;
      padding: 20px;
    }

    .hero h1 {
      font-size: 3rem;
      margin-bottom: 1rem;
      text-shadow: 2px 2px 8px rgba(0, 0, 0, 0.6);
    }

    .hero p {
      font-size: 1.2rem;
      max-width: 600px;
      text-shadow: 1px 1px 6px rgba(0, 0, 0, 0.5);
    }

    .buttons {
      margin-top: 2rem;
    }

    .buttons a {
      display: inline-block;
      padding: 10px 20px;
      margin: 0 10px;
      background-color: #ffffff;
      color: #333;
      text-decoration: none;
      border-radius: 8px;
      font-weight: 600;
      transition: 0.3s;
    }

    .buttons a:hover {
      background-color: #333;
      color: #fff;
    }
  </style>
</head>
<body>
  <div class="hero">
    <h1>Welcome to Kaksh 🏠</h1>
    <p>Find your perfect rental room with ease. Reliable listings. Secure bookings. Smart living.</p>
    <div class="buttons">
      <a href="/kaksh">Home</a>
      <% if (!currentUser) { %>
        <a href="/login">Login</a>
        <a href="/register">Register</a>
      <% } else { %>
        <a href="/logout">Logout</a>
      <% } %>
    </div>
  </div>
</body>
