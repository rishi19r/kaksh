<% layout('layouts/boilerplate') %>

<div class="custom-error-alert">
  <div>
    <h4 class="alert-heading"><%= err.message %></h4>
    <p>You got an error.</p>
    <hr>
    <p class="mb-0">Please try again or contact support.</p>
    <a href="/kaksh" class="back-btn">← Back to Kaksh</a>
  </div>
</div>

<style>
  .custom-error-alert {
    display: flex;
    justify-content: center;
    align-items: center;
    background: rgba(220, 53, 69, 0.4);
    color: #fff;
    padding: 40px;
    border-radius: 0;
    margin: 0;
    width: 100vw;
    height: 100vh;
    border: none;
    box-shadow: none;
    background-image: url('/roomphoto/error.jpg');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    position: fixed;
    top: 0;
    left: 0;
    overflow: hidden;
  }

  .custom-error-alert::before {
    content: '';
    display: none; /* blur removed */
  }

  .custom-error-alert > div {
    background-color: rgba(0, 0, 0, 0.6);
    padding: 30px;
    border-radius: 8px;
    z-index: 2;
    text-align: center;
  }

  .custom-error-alert .alert-heading {
    margin-top: 0;
    font-size: 24px;
    font-weight: bold;
  }

  .custom-error-alert p {
    margin: 8px 0;
    font-size: 18px;
  }

  .back-btn {
    display: inline-block;
    margin-top: 20px;
    padding: 10px 20px;
    background-color: #6c63ff;
    color: #fff;
    text-decoration: none;
    border-radius: 6px;
    font-weight: bold;
    transition: background-color 0.3s ease;
  }

  .back-btn:hover {
    background-color: #5848e5;
  }
</style>
